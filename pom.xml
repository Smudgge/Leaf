<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.github.smuddgge</groupId>
  <artifactId>Leaf</artifactId>
  <version>HIDDEN</version>
  <packaging>pom</packaging>

  <name>Leaf</name>
  <description>A velocity utility plugin</description>

  <modules>
    <module>libraries</module>
    <module>velocity</module>
  </modules>

  <properties>
    <java.version>17</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <repositories> <!-- Repositories in All -->
    <!-- Paper -->
    <repository>
      <id>papermc-repo</id>
      <url>https://repo.papermc.io/repository/maven-public/</url>
    </repository>

    <!-- Jitpack (GitHub Projects) -->
    <repository>
      <id>jitpack.io</id>
      <url>https://jitpack.io</url>
    </repository>

    <!-- Spark -->
    <repository>
      <id>sonatype-snapshots</id>
      <url>https://oss.sonatype.org/content/repositories/snapshots</url>
    </repository>

    <!-- Discord Bot -->
    <repository>
      <id>dv8tion</id>
      <name>m2-dv8tion</name>
      <url>https://m2.dv8tion.net/releases</url>
    </repository>
  </repositories>

  <dependencies> <!-- Dependencies in All -->
    <!-- Velocity -->
    <dependency>
      <groupId>com.velocitypowered</groupId>
      <artifactId>velocity-api</artifactId>
      <version>3.4.0-SNAPSHOT</version>
      <scope>provided</scope>
    </dependency>

    <!-- Jupiter Tests -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <version>5.9.2</version>
      <scope>test</scope>
    </dependency>

    <!-- MiniPlaceholders -->
    <dependency>
      <groupId>io.github.miniplaceholders</groupId>
      <artifactId>miniplaceholders-api</artifactId>
      <version>2.2.2</version>
      <scope>provided</scope>
    </dependency>

    <!-- Spark -->
    <dependency>
      <groupId>me.lucko</groupId>
      <artifactId>spark-api</artifactId>
      <version>0.1-SNAPSHOT</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <dependencyManagement> <!-- Manage Dependency Versions -->
    <dependencies>
      <!-- Tools, Configuration and Database Library -->
      <!-- Includes Gson, slf4j and Jetbrains annotations -->
      <dependency>
        <groupId>com.github.squishylib</groupId>
        <artifactId>SquishyLibrary</artifactId>
        <version>2.4.6</version>
      </dependency>

      <!-- Discord Webhooks -->
      <dependency>
        <groupId>club.minnced</groupId>
        <artifactId>discord-webhooks</artifactId>
        <version>0.8.4</version>
      </dependency>

      <!-- Discord Bot -->
      <dependency>
        <groupId>net.dv8tion</groupId>
        <artifactId>JDA</artifactId>
        <version>5.0.0-beta.14</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
